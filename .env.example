# Drone Flight Report — environment variables
# Copy to .env (or set in systemd Environment= / docker -e).
# All are optional; defaults shown.

# Bind address
HOST=0.0.0.0

# Port: wsgi.py default 8080, app.py dev default 5000
PORT=8080

# 0 = production (default). 1 = local debugging only.
DEBUG=0

# waitress worker threads (wsgi.py)
THREADS=4

# Optional: 天地图 API key (free at https://console.tianditu.gov.cn/).
# Adds the official Chinese satellite basemap (CGCS2000 / BeiDou-aligned)
# to the interactive track map. Leave empty to use Esri + 高德 only.
TIANDITU_KEY=

# Optional: IndexNow key (public). Served at /<key>.txt for Bing/Yandex.
# Any 8-128 char string works; changing it invalidates the old key file.
INDEXNOW_KEY=227dce2d9bae4cb3a113c6c392e85b1f
